# Ignore all files by default, but scan all directories.
*
!*/

# JetBrains Rider. Everything here is per-developer state (window layout,
# local run configs, indexing); nothing in it is worth sharing.
.idea/

# Claude Code. Only the personal override is ignored - a project-level
# .claude/settings.json, CLAUDE.md or shared agents/skills should be committed.
.claude/settings.local.json

# Compiled Object files
*.slo
*.lo
*.o
*.obj
# Do not ignore git files in the root of the repo.
!/.git*

# Do not ignore current project's `.uproject`.
!/*.uproject

# Do not ignore source, config and plugins dirs.
!/Source/**
!/Config/**
!/Plugins/**

# Build artifacts (keep local, never commit)
/Binaries/**
/Intermediate/**
/Saved/**
/DerivedDataCache/**
/Plugins/**/Binaries/**
/Plugins/**/Intermediate/**

# Only allow .uasset and .umap files from /Content dir.
# They're tracked by git-lfs, don't forget to track other
# files if adding them here.
!/Content/**/*.uasset
!/Content/**/*.umap

# Allow any files from /RawContent dir.
# Any file in /RawContent dir will be managed by git lfs.
!/RawContent/**/*

# OS/platform generated files.

# Windows
ehthumbs.db
Thumbs.db

# Mac OS X
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# vim
[._]*.s[a-w][a-z]
[._]s[a-w][a-z]
*.un~
Session.vim
.netrwhist

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# ---------------------------------------------------------------------------
# Godot 4 port (caddy-godot/)
# ---------------------------------------------------------------------------

# This file ignores everything by default (the `*` at the top) and allowlists
# the Unreal directories back in. The Godot project is not one of those, so it
# has to be allowlisted explicitly or every new file in it is silently dropped:
# `git status` stays clean and nothing warns you, while the scenes that DO get
# committed end up referencing scripts that never left this machine.
!/caddy-godot/**

# Everything below re-ignores the parts that must not be committed. Order
# matters: these have to come after the allowlist above to take effect.

# Editor cache: imported assets, shader cache, the global class registry.
# Fully regenerable with:
#   godot --headless --editor --quit --path caddy-godot
# Note the flip side: if this is missing, a headless run hangs silently at idle
# memory instead of erroring, because class_name types cannot resolve.
/caddy-godot/.godot/

# Export output and presets. export_presets.cfg can hold keystore paths and
# passwords, so it stays out of the repo.
/caddy-godot/export_presets.cfg
/caddy-godot/export.cfg
/caddy-godot/build/
/caddy-godot/exports/

# Android build template, only present if one is installed.
/caddy-godot/android/

# Generated from CSV translation sources.
/caddy-godot/*.translation

# C#/Mono leftovers, harmless if the project stays pure GDScript.
/caddy-godot/.mono/
/caddy-godot/data_*/
/caddy-godot/mono_crash.*.json

# Deliberately NOT ignored:
#   *.uid       - stable resource ids Godot 4.4+ writes next to each script.
#                 Dropping them makes references break on other machines.
#   *.import    - import settings for committed assets (icon.svg.import).
#   .editorconfig, project.godot, resources/, scenes/, scripts/, tests/
# Visual Studio
.vs
